{
  "name": "blog",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check": "astro check",
    "preview": "astro preview",
    "astro": "astro",
    "new": "node scripts/new-post.mjs",
    "fmt:frontmatter": "node scripts/fmt-frontmatter.mjs",
    "lint:md": "markdownlint-cli2 \"src/content/blog/**/*.md\" \"docs/*.md\"",
    "fix:md": "markdownlint-cli2 --fix \"src/content/blog/**/*.md\" \"docs/*.md\"",
    "format": "prettier --write \"**/*.{js,mjs,ts,astro,css,json}\"",
    "verify": "npm run check && npm run lint:md && npm run build",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "src/content/blog/**/*.md": "markdownlint-cli2 --fix",
    "docs/*.md": "markdownlint-cli2 --fix"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.2.0",
    "sharp": "^0.35.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "lint-staged": "^16.4.0",
    "markdownlint-cli2": "^0.24.1",
    "prettier": "^3.10.1",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}

