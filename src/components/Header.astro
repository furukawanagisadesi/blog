---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<h2><a href={import.meta.env.BASE_URL.replace(/\/$/, '') + '/'}>{SITE_TITLE}</a></h2>
		<div class="internal-links">
			<HeaderLink href="/">首页</HeaderLink>
			<HeaderLink href="/tags">标签</HeaderLink>
			<HeaderLink href="/about">关于</HeaderLink>
			<button type="button" class="theme-toggle" data-theme-toggle aria-label="切换主题，当前跟随系统" title="切换主题，当前跟随系统">
				<svg class="icon icon-auto" viewBox="0 0 24 24" aria-hidden="true">
					<circle cx="12" cy="12" r="8" fill="none" stroke="currentColor" stroke-width="2" />
					<path d="M12 4a8 8 0 0 0 0 16z" fill="currentColor" />
				</svg>
				<svg class="icon icon-light" viewBox="0 0 24 24" aria-hidden="true">
					<circle cx="12" cy="12" r="4.5" fill="currentColor" />
					<path
						d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M19.1 4.9l-1.8 1.8M6.7 17.3l-1.8 1.8"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
					/>
				</svg>
				<svg class="icon icon-dark" viewBox="0 0 24 24" aria-hidden="true">
					<path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5z" fill="currentColor" />
				</svg>
			</button>
		</div>
	</nav>
</header>
<script>
	// 主题三态循环：自动 → 浅色 → 深色 → 自动。自动态不写 data-theme，交给 CSS 跟随系统。
	const STORAGE_KEY = 'theme';
	type Mode = 'auto' | 'light' | 'dark';
	const MODES: Mode[] = ['auto', 'light', 'dark'];
	const LABELS: Record<Mode, string> = {
		auto: '切换主题，当前跟随系统',
		light: '切换主题，当前浅色',
		dark: '切换主题，当前深色',
	};

	function readMode(): Mode {
		try {
			const saved = localStorage.getItem(STORAGE_KEY);
			return MODES.includes(saved as Mode) ? (saved as Mode) : 'auto';
		} catch {
			// 隐私模式下 localStorage 会抛异常，此时退化为仅本次会话生效
			return 'auto';
		}
	}

	function isDark(mode: Mode): boolean {
		if (mode === 'dark') return true;
		if (mode === 'light') return false;
		return window.matchMedia('(prefers-color-scheme: dark)').matches;
	}

	function syncThemeColor(mode: Mode) {
		const bar = document.querySelector('meta[name="theme-color"]');
		if (bar) bar.setAttribute('content', isDark(mode) ? '#16181d' : '#fdfdfc');
	}

	function applyMode(mode: Mode) {
		if (mode === 'auto') {
			delete document.documentElement.dataset.theme;
		} else {
			document.documentElement.dataset.theme = mode;
		}
		try {
			localStorage.setItem(STORAGE_KEY, mode);
		} catch {
			// 存不了就只影响当前页面，不阻断切换
		}
		syncThemeColor(mode);
		const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
		if (button) {
			button.setAttribute('aria-label', LABELS[mode]);
			button.title = LABELS[mode];
		}
	}

	const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
	if (toggle) {
		applyMode(readMode());
		toggle.addEventListener('click', () => {
			const next = MODES[(MODES.indexOf(readMode()) + 1) % MODES.length];
			applyMode(next);
		});
		// 处于「自动」时，系统偏好变化要同步地址栏配色
		window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
			if (readMode() === 'auto') syncThemeColor('auto');
		});
	}
</script>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: var(--bg);
		border-bottom: 1px solid var(--gray-light);
		box-shadow: none;
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav h2 a,
	nav h2 a.active {
		color: var(--black);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	nav a {
		padding: 1em 0.5em;
		color: var(--accent);
		border-bottom: 4px solid transparent;
		text-decoration: none;
		transition: color 0.2s ease;
	}
	nav a:hover {
		color: var(--accent-dark);
	}
	nav a.active {
		text-decoration: none;
		color: var(--black);
		font-weight: 700;
		border-bottom-color: var(--accent);
	}
	.internal-links {
		display: flex;
		align-items: center;
	}
	.theme-toggle {
		display: flex;
		align-items: center;
		padding: 1em 0.5em;
		border: 0;
		background: none;
		color: var(--accent);
		cursor: pointer;
		transition: color 0.2s ease;
	}
	.theme-toggle:hover {
		color: var(--accent-dark);
	}
	.icon {
		width: 1.1em;
		height: 1.1em;
		display: none;
	}
	/* 未设置 data-theme 即「自动」，图标随状态三选一显示 */
	html:not([data-theme]) .icon-auto,
	html[data-theme='light'] .icon-light,
	html[data-theme='dark'] .icon-dark {
		display: block;
	}

	@media (max-width: 480px) {
		header {
			padding-top: 0.5em;
		}
		nav {
			flex-direction: column;
			align-items: flex-start;
		}
		.internal-links {
			display: flex;
			flex-wrap: wrap;
		}
		nav a {
			padding: 0.5em;
		}
		.theme-toggle {
			padding: 0.5em;
		}
	}
</style>
