---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';
import { isUpdatedAfterPublished } from '../lib/dates';

interface Props {
	posts: CollectionEntry<'blog'>[];
}

const { posts } = Astro.props;
---

<style>
	ul {
		list-style-type: none;
		margin: 0;
		padding: 0;
	}
	ul li {
		padding: 1.4rem 0;
		border-bottom: 1px solid color-mix(in srgb, var(--gray-light) 70%, transparent);
		transition: border-color 0.2s ease;
	}
	ul li:last-child {
		border-bottom: none;
	}
	ul li:hover {
		border-bottom-color: var(--accent);
	}
	ul li a {
		text-decoration: none;
	}
	.title {
		margin: 0 0 0.35em 0;
		color: var(--black);
		line-height: 1.3;
		transition:
			color 0.2s ease,
			transform 0.2s ease;
	}
	ul li a:hover .title {
		color: var(--accent);
		transform: translateX(3px);
	}
	.description {
		margin: 0;
		color: var(--gray);
		line-height: 1.6;
	}
	.date {
		margin: 0.6em 0 0 0;
		font-size: 0.85rem;
		color: var(--gray);
	}
</style>

<ul>
	{
		posts.map((post) => (
			<li>
				<a href={import.meta.env.BASE_URL.replace(/\/$/, '') + '/' + post.id + '/'}>
					<h3 class="title">{post.data.title}</h3>
					<p class="description">{post.data.description}</p>
					<p class="date">
						<FormattedDate date={post.data.pubDate} />
						{post.data.updatedDate && isUpdatedAfterPublished(post.data.pubDate, post.data.updatedDate) && (
							<> · 更新于 <FormattedDate date={post.data.updatedDate} /></>
						)}
					</p>
				</a>
			</li>
		))
	}
</ul>
