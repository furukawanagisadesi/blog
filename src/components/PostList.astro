---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';
import { isUpdatedAfterPublished } from '../lib/dates';

interface Props {
	posts: CollectionEntry<'blog'>[];
}

const { posts } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<style>
	ul {
		list-style-type: none;
		margin: 0;
		padding: 0;
	}
	ul li {
		border-bottom: 1px solid var(--hairline);
	}
	ul li:last-child {
		border-bottom: none;
	}
	ul li a {
		display: block;
		padding: 1.6rem 1rem 1.6rem 0.25rem;
		text-decoration: none;
		border-radius: 10px;
		transition: background-color 0.25s var(--ease);
	}
	ul li a:hover {
		background-color: color-mix(in srgb, var(--surface) 65%, transparent);
	}
	.title {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1.5em;
		margin: 0 0 0.4em 0;
		color: var(--black);
		font-size: 1.15em;
		line-height: 1.35;
		transition: color 0.2s var(--ease);
	}
	ul li a:hover .title {
		color: var(--accent);
	}
	/* 标题右侧的箭头只在指针设备上露头，暗示整行可点 */
	.title::after {
		content: '→';
		flex: none;
		color: var(--accent);
		opacity: 0;
		transform: translateX(-6px);
		transition:
			opacity 0.25s var(--ease),
			transform 0.25s var(--ease);
	}
	ul li a:hover .title::after {
		opacity: 1;
		transform: none;
	}
	.description {
		margin: 0;
		max-width: 46em;
		color: var(--gray);
		line-height: 1.7;
	}
	.meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5em;
		margin: 0.7em 0 0;
		font-size: 0.85rem;
		color: var(--gray);
	}
	.meta .dot {
		color: var(--gray-light);
	}
	/* 标签单独一行：和日期挤在一起会在一行里留下孤零零的分隔点 */
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4em;
		margin: 0.55em 0 0;
	}
	.tag {
		padding: 0.15em 0.6em;
		border: 1px solid var(--hairline);
		border-radius: 999px;
		font-size: 0.78rem;
		line-height: 1.6;
		color: var(--gray);
		transition:
			color 0.2s var(--ease),
			border-color 0.2s var(--ease);
	}
	ul li a:hover .tag {
		color: var(--accent);
		border-color: color-mix(in srgb, var(--accent) 40%, transparent);
	}

	@media (hover: none) {
		.title::after {
			display: none;
		}
	}

	@media (max-width: 720px) {
		ul li a {
			padding: 1.3rem 0.5rem 1.3rem 0.25rem;
		}
		.title {
			font-size: 1.05em;
			gap: 1em;
		}
	}
</style>

<ul>
	{
		posts.map((post) => (
			<li data-reveal>
				<a href={base + '/' + post.id + '/'}>
					<h3 class="title">{post.data.title}</h3>
					<p class="description">{post.data.description}</p>
					<p class="meta">
						<FormattedDate date={post.data.pubDate} />
						{post.data.updatedDate && isUpdatedAfterPublished(post.data.pubDate, post.data.updatedDate) && (
							<>
								<span class="dot">·</span>
								<span>更新于 <FormattedDate date={post.data.updatedDate} /></span>
							</>
						)}
					</p>
					{post.data.tags.length > 0 && (
						<p class="tags">
							{post.data.tags.map((tag) => (
								<span class="tag">{tag}</span>
							))}
						</p>
					)}
				</a>
			</li>
		))
	}
</ul>
