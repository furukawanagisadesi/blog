---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import FormattedDate from '../components/FormattedDate.astro';
import BaseLayout from './BaseLayout.astro';
import { slugifyTag } from '../lib/tags';
import { isUpdatedAfterPublished } from '../lib/dates';

interface Props {
	title: string;
	description: string;
	pubDate?: Date;
	updatedDate?: Date;
	heroImage?: ImageMetadata;
	tags?: string[];
	showComments?: boolean;
	ogType?: 'website' | 'article';
}

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	tags = [],
	showComments = true,
	ogType = 'article',
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title={title} description={description} image={heroImage} ogType={ogType}>
	<style>
		main {
			width: calc(100% - 2em);
			max-width: 100%;
			margin: 0;
		}
		.hero-image {
			width: 100%;
			max-width: var(--content-width);
			margin: 0 auto;
		}
		.hero-image img {
			display: block;
			margin: 0 auto;
			border-radius: 12px;
			box-shadow: var(--box-shadow);
		}
		.prose {
			width: var(--content-width);
			max-width: calc(100% - 2em);
			margin: auto;
			padding: 1em;
			color: rgb(var(--gray-dark));
		}
		.title {
			margin-bottom: 1em;
			padding: 1em 0;
			text-align: center;
			line-height: 1;
		}
		.title h1 {
			margin: 0 0 0.5em 0;
		}
		.date {
			margin-bottom: 0.5em;
			color: rgb(var(--gray));
		}
		.last-updated-on {
			font-style: italic;
		}
		.tags {
			list-style: none;
			margin: 0 0 1em 0;
			padding: 0;
			display: flex;
			flex-wrap: wrap;
			gap: 0.5em;
			justify-content: center;
		}
		.tags a {
			display: inline-block;
			padding: 0.15em 0.6em;
			border-radius: 999px;
			background: rgb(var(--gray-light));
			color: rgb(var(--gray-dark));
			font-size: 0.8rem;
			text-decoration: none;
			transition: 0.2s ease;
		}
		.tags a:hover {
			background: rgb(var(--accent));
			color: #fff;
		}
		.comments-area {
			margin-top: 3em;
		}
		.comments-area.is-hidden {
			display: none;
		}
		.twikoo-status {
			margin-top: 3em;
			padding: 2em 1em;
			text-align: center;
			color: rgb(var(--gray));
			border: 1px dashed rgb(var(--gray-light));
			border-radius: 12px;
		}
		.twikoo-status[hidden] {
			display: none;
		}
		.twikoo-status p {
			margin: 0 0 1em;
		}
		.twikoo-status button {
			font: inherit;
			font-size: 0.9em;
			padding: 0.5em 1.2em;
			border: 0;
			border-radius: 999px;
			background: var(--accent);
			color: #fff;
			cursor: pointer;
		}
		.twikoo-status button:hover {
			background: var(--accent-dark);
		}
	</style>
	<main>
		<article>
			{
				heroImage && (
					<div class="hero-image">
						<Image width={1020} height={510} src={heroImage} alt="" />
					</div>
				)
			}
			<div class="prose">
				<div class="title">
					{
						pubDate && (
							<div class="date">
								<FormattedDate date={pubDate} />
								{updatedDate && isUpdatedAfterPublished(pubDate, updatedDate) && (
									<div class="last-updated-on">
										最后更新于 <FormattedDate date={updatedDate} />
									</div>
								)}
							</div>
						)
					}
					<h1>{title}</h1>
					{
						tags.length > 0 && (
							<ul class="tags">
								{tags.map((tag) => (
									<li>
										<a href={base + '/tags/' + slugifyTag(tag) + '/'}>{tag}</a>
									</li>
								))}
							</ul>
						)
					}
					<hr />
				</div>
				<slot />
				{
					showComments && (
						<>
							<div class="comments-area" data-twikoo>
								<div id="twikoo" />
							</div>
							<div id="twikoo-status" class="twikoo-status" role="status" aria-live="polite" hidden>
								<p class="twikoo-status-text" />
								<button type="button" class="twikoo-status-retry">
									重新加载评论
								</button>
							</div>
						</>
					)
				}
			</div>
		</article>
	</main>
	{
		showComments && (
			<script define:vars={{ twikooAssetBase: base + '/vendor/twikoo/1.7.20' }}>
				(function () {
					var wrapper = document.querySelector('[data-twikoo]');
					var status = document.getElementById('twikoo-status');
					if (!wrapper || !status) return;
					var statusText = status.querySelector('.twikoo-status-text');
					var retryButton = status.querySelector('.twikoo-status-retry');
					var envId = 'https://vercel-69q075mt0-furukawanagisadesi.vercel.app';
					var slowTimeout = 15000;
					var attempt = 0;
					var timer = 0;
					var settled = false;
					var scriptLoading = false;
					var scriptLoaded = false;
					var observer = null;

					var currentBox = function () {
						var box = wrapper.querySelector('#twikoo');
						if (!box) {
							box = document.createElement('div');
							box.id = 'twikoo';
							wrapper.appendChild(box);
						}
						return box;
					};

					var isVisible = function (el) {
						if (!el) return false;
						var style = window.getComputedStyle(el);
						return style.display !== 'none' && style.visibility !== 'hidden';
					};

					var clearTimer = function () {
						if (timer) {
							window.clearTimeout(timer);
							timer = 0;
						}
					};

					var showStatus = function (message) {
						statusText.textContent = message;
						status.hidden = false;
						wrapper.classList.add('is-hidden');
					};

					var hideStatus = function () {
						status.hidden = true;
						wrapper.classList.remove('is-hidden');
					};

					var fail = function (message) {
						settled = true;
						clearTimer();
						showStatus(message);
					};

					var checkFailure = function () {
						if (settled) return;
						var error = wrapper.querySelector('.tk-comments-error');
						if (isVisible(error) && error.textContent.trim()) {
							fail('评论加载失败，请检查网络或代理。');
							return;
						}
						// Twikoo 1.7.20 请求失败时会同时渲染「没有评论」和「查看更多」，
						// 成功返回 0 条评论时 showExpand 为 false，不会出现该组合。
						var empty = wrapper.querySelector('.tk-comments-no');
						var expand = wrapper.querySelector('.tk-expand');
						if (isVisible(empty) && isVisible(expand)) {
							fail('评论加载失败，请检查网络或代理。');
						}
					};

					var start = function (myAttempt) {
						if (myAttempt !== attempt) return;
						settled = false;
						hideStatus();
						clearTimer();
						var box = currentBox();
						box.innerHTML = '';
						var result;
						try {
							result = window.twikoo.init({
								envId: envId,
								onCommentLoaded: function () {
									if (myAttempt !== attempt) return;
									settled = true;
									clearTimer();
									hideStatus();
								},
							});
						} catch (e) {
							fail('评论加载失败，请刷新页面重试。');
							return;
						}
						if (result && typeof result.catch === 'function') {
							// 访客计数等附加请求失败不应中断评论区
							result.catch(function () {});
						}
						timer = window.setTimeout(function () {
							if (myAttempt !== attempt || settled) return;
							showStatus('评论加载较慢，请检查网络或代理。');
						}, slowTimeout);
						if (!observer) {
							observer = new MutationObserver(checkFailure);
							observer.observe(wrapper, { childList: true, subtree: true, attributes: true });
						}
					};

					var beginAttempt = function () {
						var myAttempt = ++attempt;
						if (window.twikoo && typeof window.twikoo.init === 'function') {
							start(myAttempt);
							return;
						}
						if (scriptLoading) return;
						scriptLoading = true;
						var script = document.createElement('script');
						script.src = twikooAssetBase + '/twikoo.min.js';
						script.onload = function () {
							scriptLoading = false;
							scriptLoaded = true;
							start(++attempt);
						};
						script.onerror = function () {
							scriptLoading = false;
							scriptLoaded = false;
							fail('评论组件加载失败，请刷新页面重试。');
						};
						document.body.appendChild(script);
					};

					var loadCss = function () {
						if (document.querySelector('link[data-twikoo-css]')) return;
						var link = document.createElement('link');
						link.rel = 'stylesheet';
						link.href = twikooAssetBase + '/twikoo.css';
						link.setAttribute('data-twikoo-css', '');
						document.head.appendChild(link);
					};

					var init = function () {
						loadCss();
						beginAttempt();
					};

					retryButton.addEventListener('click', function () {
						if (!scriptLoaded && !(window.twikoo && window.twikoo.init)) {
							scriptLoading = false;
						}
						beginAttempt();
					});

					if (!('IntersectionObserver' in window)) {
						// 兜底：不支持 IntersectionObserver 时立即加载
						if (document.readyState === 'complete') init();
						else window.addEventListener('load', init);
						return;
					}
					// 滚动到评论区附近（提前 200px）再加载
					var io = new IntersectionObserver(
						function (entries) {
							for (var i = 0; i < entries.length; i++) {
								if (entries[i].isIntersecting) {
									io.disconnect();
									init();
									return;
								}
							}
						},
						{ rootMargin: '200px 0px' },
					);
					io.observe(wrapper);
				})();
			</script>
		)
	}
</BaseLayout>
