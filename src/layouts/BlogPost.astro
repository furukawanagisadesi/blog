---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import FormattedDate from '../components/FormattedDate.astro';
import BaseLayout from './BaseLayout.astro';
import { slugifyTag } from '../lib/tags';
import { isUpdatedAfterPublished } from '../lib/dates';

interface Props {
	title: string;
	description: string;
	pubDate?: Date;
	updatedDate?: Date;
	heroImage?: ImageMetadata;
	tags?: string[];
	showComments?: boolean;
	ogType?: 'website' | 'article';
}

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	tags = [],
	showComments = true,
	ogType = 'article',
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title={title} description={description} image={heroImage} ogType={ogType}>
	<style>
		main {
			width: calc(100% - 2em);
			max-width: 100%;
			margin: 0;
		}
		.hero-image {
			width: 100%;
			max-width: var(--content-width);
			margin: 0 auto;
		}
		.hero-image img {
			display: block;
			margin: 0 auto;
			border-radius: 12px;
			box-shadow: var(--box-shadow);
		}
		.prose {
			width: var(--content-width);
			max-width: calc(100% - 2em);
			margin: auto;
			padding: 1em;
			color: rgb(var(--gray-dark));
		}
		.title {
			margin-bottom: 1em;
			padding: 1em 0;
			text-align: center;
			line-height: 1;
		}
		.title h1 {
			margin: 0 0 0.5em 0;
		}
		.date {
			margin-bottom: 0.5em;
			color: rgb(var(--gray));
		}
		.last-updated-on {
			font-style: italic;
		}
		.tags {
			list-style: none;
			margin: 0 0 1em 0;
			padding: 0;
			display: flex;
			flex-wrap: wrap;
			gap: 0.5em;
			justify-content: center;
		}
		.tags a {
			display: inline-block;
			padding: 0.15em 0.6em;
			border-radius: 999px;
			background: rgb(var(--gray-light));
			color: rgb(var(--gray-dark));
			font-size: 0.8rem;
			text-decoration: none;
			transition: 0.2s ease;
		}
		.tags a:hover {
			background: rgb(var(--accent));
			color: #fff;
		}
	</style>
	<main>
		<article>
			{
				heroImage && (
					<div class="hero-image">
						<Image width={1020} height={510} src={heroImage} alt="" />
					</div>
				)
			}
			<div class="prose">
				<div class="title">
					{
						pubDate && (
							<div class="date">
								<FormattedDate date={pubDate} />
								{updatedDate && isUpdatedAfterPublished(pubDate, updatedDate) && (
									<div class="last-updated-on">
										最后更新于 <FormattedDate date={updatedDate} />
									</div>
								)}
							</div>
						)
					}
					<h1>{title}</h1>
					{
						tags.length > 0 && (
							<ul class="tags">
								{tags.map((tag) => (
									<li>
										<a href={base + '/tags/' + slugifyTag(tag) + '/'}>{tag}</a>
									</li>
								))}
							</ul>
						)
					}
					<hr />
				</div>
				<slot />
				{showComments && <div id="twikoo" style="margin-top: 3em;"></div>}
			</div>
		</article>
	</main>
	{
		showComments && (
			<script>
				(function () {
					var loaded = false;
					var envId = 'https://vercel-69q075mt0-furukawanagisadesi.vercel.app';
					var init = function () {
						if (loaded) return;
						loaded = true;
						// 评论区样式：延迟到需要时再插入
						var css = document.createElement('link');
						css.rel = 'stylesheet';
						css.href = 'https://unpkg.com/twikoo@1.7.20/dist/twikoo.css';
						document.head.appendChild(css);
						// 主脚本：unpkg 失败则回退 jsdelivr
						var boot = function () {
							if (window.twikoo && window.twikoo.init) {
								window.twikoo.init({ envId: envId });
							}
						};
						var s = document.createElement('script');
						s.src = 'https://unpkg.com/twikoo@1.7.20/dist/twikoo.min.js';
						s.onload = boot;
						s.onerror = function () {
							var s2 = document.createElement('script');
							s2.src = 'https://cdn.jsdelivr.net/npm/twikoo@1.7.20/dist/twikoo.min.js';
							s2.onload = boot;
							document.body.appendChild(s2);
						};
						document.body.appendChild(s);
					};
					var target = document.getElementById('twikoo');
					if (!target || !('IntersectionObserver' in window)) {
						// 兜底：不支持 IntersectionObserver 或找不到容器时立即加载
						if (document.readyState === 'complete') init();
						else window.addEventListener('load', init);
						return;
					}
					// 滚动到评论区附近（提前 200px）再加载
					var io = new IntersectionObserver(
						function (entries) {
							for (var i = 0; i < entries.length; i++) {
								if (entries[i].isIntersecting) {
									io.disconnect();
									init();
									return;
								}
							}
						},
						{ rootMargin: '200px 0px' },
					);
					io.observe(target);
				})();
			</script>
		)
	}
</BaseLayout>
