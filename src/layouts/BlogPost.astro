---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage, showComments = true } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: rgb(var(--gray-dark));
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
			}
			.date {
				margin-bottom: 0.5em;
				color: rgb(var(--gray));
			}
			.last-updated-on {
				font-style: italic;
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="hero-image">
					{heroImage && <Image width={1020} height={510} src={heroImage} alt="" />}
				</div>
				<div class="prose">
					<div class="title">
						<div class="date">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<div class="last-updated-on">
										Last updated on <FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
						<h1>{title}</h1>
						<hr />
					</div>
					<slot />
					{showComments && <div id="twikoo" style="margin-top: 3em;"></div>}
				</div>
			</article>
		</main>
		{showComments && (
			<>
				<link rel="stylesheet" href="https://unpkg.com/twikoo@1.7.20/dist/twikoo.css" />
				<script>
					// 避免全局污染与重复加载，用 window.twikoo 判断
					window.addEventListener('load', function () {
						var loaded = false;
						var init = function () {
							if (loaded) return;
							loaded = true;
							if (window.twikoo && window.twikoo.init) {
								window.twikoo.init({
									envId: 'https://vercel-69q075mt0-furukawanagisadesi.vercel.app',
								});
							}
						};
						// 引入主脚本（unpkg 失败则回退 jsdelivr）
						var s = document.createElement('script');
						s.src = 'https://unpkg.com/twikoo@1.7.20/dist/twikoo.min.js';
						s.onload = init;
						s.onerror = function () {
							var s2 = document.createElement('script');
							s2.src = 'https://cdn.jsdelivr.net/npm/twikoo@1.7.20/dist/twikoo.min.js';
							s2.onload = init;
							document.body.appendChild(s2);
						};
						document.body.appendChild(s);
					});
				</script>
			</>
		)}
		<Footer />
	</body>
</html>
