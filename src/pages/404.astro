---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="页面未找到" description="你访问的页面不存在">
	<main class="not-found">
		<p class="code">404</p>
		<h1>页面走丢了</h1>
		<p class="hint">可能已被移除，或者地址拼写有误。</p>
		<div class="actions">
			<a class="primary" href={base + '/'}>返回首页</a>
			<a href={base + '/tags/'}>浏览标签</a>
		</div>
	</main>
</BaseLayout>

<style>
	.not-found {
		width: var(--content-width);
		max-width: calc(100% - 2em);
		padding: 16vh 1em 4em;
		text-align: center;
	}
	.code {
		margin: 0 0 0.2em;
		color: var(--accent);
		font-family: var(--font-mono);
		font-size: clamp(3.5rem, 12vw, 6rem);
		font-weight: 700;
		letter-spacing: -0.03em;
		line-height: 1;
	}
	h1 {
		margin: 0 0 0.6em;
		font-size: 1.4em;
	}
	.hint {
		margin: 0 0 2.5em;
		color: var(--gray);
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.75em;
	}
	.actions a {
		padding: 0.55em 1.4em;
		border: 1px solid var(--gray-light);
		border-radius: 999px;
		text-decoration: none;
		transition:
			color 0.2s var(--ease),
			border-color 0.2s var(--ease),
			background-color 0.2s var(--ease);
	}
	.actions a:hover {
		border-color: var(--accent);
		color: var(--accent);
	}
	.actions a.primary {
		border-color: var(--accent);
		background-color: var(--accent);
		color: var(--on-accent);
	}
	.actions a.primary:hover {
		border-color: var(--accent-dark);
		background-color: var(--accent-dark);
		color: var(--on-accent);
	}
</style>
