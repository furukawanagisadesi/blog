---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import { getAllTags, getPostsByTag } from '../../lib/tags';

export async function getStaticPaths() {
	const tags = await getAllTags();
	return tags.map((tag) => ({
		params: { tag: tag.slug },
		props: { tag: tag.tag },
	}));
}

const { tag } = Astro.props;
const posts = await getPostsByTag(Astro.params.tag ?? '');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title={`标签：${tag}`} description={`标签「${tag}」下的全部文章`}>
	<style>
		.head {
			padding: 1em 0 1.5em;
			border-bottom: 1px solid var(--hairline);
		}
		.crumb {
			margin: 0 0 0.9em;
			font-family: var(--font-mono);
			font-size: 0.72rem;
			letter-spacing: 0.1em;
			text-transform: uppercase;
			color: var(--gray);
		}
		.crumb a {
			color: var(--gray);
			text-decoration: none;
		}
		.crumb a:hover {
			color: var(--accent);
		}
		h1 {
			margin: 0 0 0.3em;
			font-size: clamp(1.7rem, 4vw, 2.2rem);
			letter-spacing: -0.02em;
		}
		.meta {
			margin: 0;
			color: var(--gray);
			font-size: 0.9rem;
		}
	</style>
	<main>
		<div class="head" data-reveal>
			<p class="crumb"><a href={base + '/tags/'}>标签</a> /</p>
			<h1>{tag}</h1>
			<p class="meta">{posts.length} 篇文章</p>
		</div>
		<PostList posts={posts} />
	</main>
</BaseLayout>
